{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchmarkReport",
  "description": "Output of one `persona_rubric_bench.run` invocation (spec 026 §2.3). Scores are keyed by the rubric's dimensions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run",
    "results"
  ],
  "properties": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "lever_1_applied",
        "started_at",
        "finished_at",
        "prompt_count"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "lever_1_applied": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "prompt_count": {
          "type": "integer",
          "minimum": 0
        },
        "judge_model": {
          "type": "string"
        },
        "ollama_host": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "rubric": {
          "type": "string"
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt_id",
          "model",
          "lever_1_applied",
          "response",
          "scores",
          "rationale",
          "timestamp",
          "latency_ms"
        ],
        "properties": {
          "prompt_id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "lever_1_applied": {
            "type": "boolean"
          },
          "response": {
            "type": "string"
          },
          "scores": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            }
          },
          "rationale": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "latency_ms": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": "string"
          },
          "character_slug": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "description": "Optional cross-prompt roll-up written by report.py.",
      "additionalProperties": true
    }
  }
}
